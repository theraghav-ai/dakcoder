{
  "name": "dakcoder-go",
  "displayName": "dakcoder",
  "description": "The India Post IT 2.0 backend coding agent for Go services on the n-api-template contract.",
  "version": "0.2.10",
  "publisher": "dop",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Testing"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "dakcoder runs the Go toolchain and writes files in the workspace."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "tsc --outDir dist-test --module CommonJS --moduleResolution Node --target ES2022 --lib ES2022,DOM --skipLibCheck --rootDir src --esModuleInterop --types node,vscode src/test/protocol.test.ts src/test/state.test.ts",
    "test": "npm run build:test && node --test dist-test/test/protocol.test.js dist-test/test/state.test.js src/test/renderer.test.mjs",
    "verify": "npm run typecheck && npm run test && npm run compile && npm run check:credentials && npm run check:commands && npm run check:l10n && npm run check:gotools",
    "package": "npm run verify && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "check:credentials": "node scripts/check-no-credentials.mjs",
    "build:integration": "tsc --outDir dist-test --module CommonJS --moduleResolution Node --target ES2022 --lib ES2022,DOM --skipLibCheck --rootDir src --esModuleInterop --types node,vscode src/test/runIntegration.ts src/test/integration/index.ts src/test/integration/activation.test.ts",
    "test:integration": "npm run compile && npm run build:integration && node dist-test/test/runIntegration.js",
    "build:gotools": "node scripts/build-gotools.mjs",
    "l10n": "node scripts/extract-l10n.mjs",
    "check:l10n": "node scripts/extract-l10n.mjs --check",
    "check:commands": "node scripts/check-commands.mjs",
    "check:gotools": "node scripts/build-gotools.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dakcoder",
          "title": "dakcoder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dakcoder": [
        {
          "id": "dakcoder.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "dakcoder.sessions",
          "name": "Sessions",
          "type": "tree"
        },
        {
          "id": "dakcoder.quota",
          "name": "Quota",
          "type": "tree"
        },
        {
          "id": "dakcoder.context",
          "name": "Context",
          "type": "tree",
          "visibility": "collapsed"
        },
        {
          "id": "dakcoder.doctor",
          "name": "Doctor",
          "type": "tree",
          "visibility": "collapsed"
        },
        {
          "id": "dakcoder.changeset",
          "name": "Proposed Changes",
          "type": "tree",
          "when": "dakcoder.changesetOpen"
        },
        {
          "id": "dakcoder.migration",
          "name": "Migration Plan",
          "type": "tree",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "dakcoder",
      "properties": {
        "dakcoder.serverGatewayUrl": {
          "type": "string",
          "default": "https://ai.cept.gov.in/dakcoder",
          "description": "The IT 2.0 gateway: sign-in, quota, and the model proxy. The agent itself always runs on this machine \u2014 your repository, build output and git history never leave it. The prompt the agent builds does go to the India Post model endpoint, over internal infrastructure only. This host publishes everything except sign-in: ask an administrator for a token and run \"dakcoder: Enter Gateway Token\"."
        },
        "dakcoder.gatewayUrl": {
          "type": "string",
          "default": "",
          "description": "Advanced override for the gateway URL, in both modes."
        },
        "dakcoder.model": {
          "type": "string",
          "default": "",
          "description": "Display-only override, and only for a role the server already permits. Empty uses the server's configured coder model."
        },
        "dakcoder.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.11+ for the local runtime. Empty auto-detects: this setting, then the Python extension's interpreter, then py/python3/python."
        },
        "dakcoder.goPath": {
          "type": "string",
          "default": "",
          "description": "Override the go binary Doctor and the gate use."
        },
        "dakcoder.goplsPath": {
          "type": "string",
          "default": "",
          "description": "Override gopls. Empty prefers the golang.go extension's managed copy, then GOBIN, then PATH."
        },
        "dakcoder.requireApproval": {
          "type": [
            "string",
            "array"
          ],
          "default": "write_side",
          "description": "Which tool calls need a human first: none, all, write_side, destructive, or an explicit list of tool names. Nothing under configs/** is ever auto-approved, whatever this says."
        },
        "dakcoder.maxTurns": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "maximum": 400,
          "markdownDescription": "How many turns one run may spend before it stops with `exhausted`. The default suits a single vertical slice; raise it (100\u2013200) for whole-service work such as a template migration. An exhausted session is never lost \u2014 **Resume** continues it on the same transcript with a fresh budget. Takes effect when the runtime restarts."
        },
        "dakcoder.approvalTimeoutSeconds": {
          "type": "number",
          "default": 0,
          "description": "How long an approval waits. 0 waits indefinitely \u2014 a slow review must never auto-reject."
        },
        "dakcoder.autoApproveTrivialPatches": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve small, unambiguous patches. Never applies under configs/**."
        },
        "dakcoder.defaultMode": {
          "type": "string",
          "enum": [
            "multi",
            "planner",
            "scaffolder",
            "coder",
            "verifier",
            "debugger"
          ],
          "default": "multi",
          "description": "Which mode a new task starts in. Multi lets the agent switch as the work demands."
        },
        "dakcoder.requestTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "description": "How long a single model request may take."
        },
        "dakcoder.runtimeIdleTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "description": "Stop the local runtime after this long with no task. 0 never stops it."
        },
        "dakcoder.showTokenMeter": {
          "type": "boolean",
          "default": true,
          "description": "Show the context and reasoning meter in the chat header."
        },
        "dakcoder.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log every tool call to the output channel."
        },
        "dakcoder.telemetry": {
          "type": "boolean",
          "default": true,
          "description": "Send anonymous usage counts. Honours the editor's own telemetry setting regardless of this."
        },
        "dakcoder.gotoolsPath": {
          "type": "string",
          "default": "",
          "description": "Override the gotools analyser. Empty uses the checksum-verified binary bundled with the extension, then any gotools on PATH."
        },
        "dakcoder.lintOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Re-run template compliance on the file you just saved. Local, offline, and costs no quota; off by default because it re-analyses the whole module on every save."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dakcoder.setup",
        "title": "Get started with dakcoder",
        "description": "Sign in, check your Go toolchain, and scaffold your first resource.",
        "steps": [
          {
            "id": "signin",
            "title": "Sign in with GitLab",
            "description": "dakcoder runs as you, so quota and audit are yours.\n[Sign In](command:dakcoder.signIn)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:dakcoder.signIn"
            ]
          },
          {
            "id": "doctor",
            "title": "Check your Go toolchain",
            "description": "Doctor finds the setup problems that would otherwise surface as a failed build.\n[Run Doctor](command:dakcoder.doctor)",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onCommand:dakcoder.doctor"
            ]
          },
          {
            "id": "open",
            "title": "Open a Go service",
            "description": "dakcoder works on repositories built on the n-api-template contract.",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onContext:dakcoder.hasGoModule"
            ]
          },
          {
            "id": "scaffold",
            "title": "Scaffold a resource",
            "description": "The wizard produces the spec, so the model never has to guess it.\n[Scaffold Resource](command:dakcoder.scaffoldResource)",
            "media": {
              "markdown": "media/walkthrough/scaffold.md"
            },
            "completionEvents": [
              "onCommand:dakcoder.scaffoldResource"
            ]
          },
          {
            "id": "review",
            "title": "Review the diff",
            "description": "Every write is yours to accept, reject, or correct.",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onCommand:dakcoder.acceptApproval"
            ]
          }
        ]
      }
    ],
    "authentication": [
      {
        "id": "dakcoder",
        "label": "dakcoder (GitLab)"
      }
    ],
