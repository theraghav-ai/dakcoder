        },
        {
          "command": "dakcoder.doctor.copyReport",
          "when": "view == dakcoder.doctor",
          "group": "navigation@2"
        },
        {
          "command": "dakcoder.doctor.showLog",
          "when": "view == dakcoder.doctor",
          "group": "navigation@3"
        },
        {
          "command": "dakcoder.clearChat",
          "when": "view == dakcoder.chat",
          "group": "navigation@1"
        },
        {
          "command": "dakcoder.migration.run",
          "when": "view == dakcoder.migration && dakcoder.hasMigrationPlan && !dakcoder.migrationLocked",
          "group": "navigation@1"
        },
        {
          "command": "dakcoder.migration.refresh",
          "when": "view == dakcoder.migration",
          "group": "navigation@2"
        },
        {
          "command": "dakcoder.migration.openPlanFile",
          "when": "view == dakcoder.migration",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dakcoder.sessions.resume",
          "when": "view == dakcoder.sessions && viewItem == dakcoder.session.resumable",
          "group": "inline@1"
        },
        {
          "command": "dakcoder.sessions.followUp",
          "when": "view == dakcoder.sessions && viewItem == dakcoder.session.done",
          "group": "inline@1"
        },
        {
          "command": "dakcoder.sessions.open",
          "when": "view == dakcoder.sessions && viewItem =~ /^dakcoder\\.session\\.(running|done|resumable|unknown)$/",
          "group": "1_open@1"
        },
        {
          "command": "dakcoder.sessions.resume",
          "when": "view == dakcoder.sessions && viewItem == dakcoder.session.resumable",
          "group": "1_open@2"
        },
        {
          "command": "dakcoder.sessions.followUp",
          "when": "view == dakcoder.sessions && viewItem == dakcoder.session.done",
          "group": "1_open@2"
        },
        {
          "command": "dakcoder.sessions.revert",
          "when": "view == dakcoder.sessions && viewItem =~ /^dakcoder\\.session\\.(done|resumable|unknown)$/",
          "group": "2_modify@1"
        },
        {
          "command": "dakcoder.sessions.delete",
          "when": "view == dakcoder.sessions && viewItem =~ /^dakcoder\\.session\\.(done|resumable|unknown)$/",
          "group": "3_danger@1"
        },
        {
          "command": "dakcoder.sessions.copyId",
          "when": "view == dakcoder.sessions && viewItem =~ /^dakcoder\\.session\\.(running|done|resumable|unknown)$/",
          "group": "4_copy@1"
        },
        {
          "command": "dakcoder.approval.showDiff",
          "group": "inline@1",
          "when": "view == dakcoder.changeset && viewItem == dakcoder.changesetFile"
        },
        {
          "command": "dakcoder.doctor.applyFix",
          "when": "view == dakcoder.doctor && viewItem == dakcoder.check.fixable",
          "group": "inline"
        },
        {
          "command": "dakcoder.migration.moveUp",
          "when": "view == dakcoder.migration && viewItem == dakcoder.migration.unit",
          "group": "inline@1"
        },
        {
          "command": "dakcoder.migration.moveDown",
          "when": "view == dakcoder.migration && viewItem == dakcoder.migration.unit",
          "group": "inline@2"
        },
        {
          "command": "dakcoder.migration.reclassify",
          "when": "view == dakcoder.migration && viewItem == dakcoder.migration.unit",
          "group": "1_order@1"
        },
        {
          "command": "dakcoder.migration.openUnit",
          "when": "view == dakcoder.migration && viewItem =~ /^dakcoder\\.migration\\.unit/",
          "group": "2_open@1"
        },
        {
          "command": "dakcoder.migration.openCommit",
          "when": "view == dakcoder.migration && viewItem == dakcoder.migration.commit",
          "group": "2_open@1"
        }
      ],
      "editor/title": [
        {
          "command": "dakcoder.approval.accept",
          "group": "navigation@1",
          "when": "resourceScheme == dakcoder-proposed"
        },
        {
          "command": "dakcoder.approval.reject",
          "group": "navigation@2",
          "when": "resourceScheme == dakcoder-proposed"
        },
        {
          "command": "dakcoder.approval.editArgs",
          "group": "navigation@3",
          "when": "resourceScheme == dakcoder-proposed"
        },
        {
          "command": "dakcoder.approval.submitArgs",
          "group": "navigation@1",
          "when": "dakcoder.editingArgs && resourceExtname == .json"
        },
        {
          "command": "dakcoder.approval.cancelArgs",
          "group": "navigation@2",
          "when": "dakcoder.editingArgs && resourceExtname == .json"
        }
      ]
    },
    "keybindings": [
      {
        "key": "1",
        "command": "dakcoder.approval.accept",
        "when": "dakcoder.approvalPending && (resourceScheme == dakcoder-proposed || focusedView == dakcoder.changeset)"
      },
      {
        "key": "2",
        "command": "dakcoder.approval.reject",
        "when": "dakcoder.approvalPending && (resourceScheme == dakcoder-proposed || focusedView == dakcoder.changeset)"
      },
      {
        "key": "3",
        "command": "dakcoder.approval.showDiff",
        "when": "dakcoder.approvalPending && (resourceScheme == dakcoder-proposed || focusedView == dakcoder.changeset)"
      },
      {
        "key": "4",
        "command": "dakcoder.approval.editArgs",
        "when": "dakcoder.approvalPending && (resourceScheme == dakcoder-proposed || focusedView == dakcoder.changeset)"
      },
      {
        "command": "dakcoder.migration.moveUp",
        "key": "alt+up",
        "when": "focusedView == dakcoder.migration && !dakcoder.migrationLocked"
      },
      {
        "command": "dakcoder.migration.moveDown",
        "key": "alt+down",
        "when": "focusedView == dakcoder.migration && !dakcoder.migrationLocked"
      }
    ],
    "viewsWelcome": [
      {
        "view": "dakcoder.doctor",
        "contents": "Doctor checks the Go toolchain, private-module credentials, the local runtime and your sign-in \u2014 and offers a one-click fix for everything it finds.\n[Run Doctor](command:dakcoder.doctor)"
      },
      {
        "view": "dakcoder.migration",
        "contents": "No migration plan yet.\n\nRun the legacy audit to inventory every handler and repo, its classification and the rules it violates. The plan is written to .dakcoder/migration/plan.md and nothing is migrated until you confirm the order here.\n[Audit Legacy Patterns](command:dakcoder.auditLegacy)\n[Reload the plan](command:dakcoder.migration.refresh)",
        "when": "!dakcoder.hasMigrationPlan"
      }
    ],
    "taskDefinitions": [
      {
        "type": "dakcoder",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "description": "The verification gate stage to run locally: go_build, go_vet, go_test, go_mod tidy, govalid_gen, golangci_lint or govulncheck."
          }
        }
      }
    ],
    "problemPatterns": [
      {
        "name": "dakcoder-go",
        "regexp": "^\\s*(.+\\.go):(\\d+):(?:(\\d+):)?\\s+(.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "message": 4
      }
    ],
    "problemMatchers": [
      {
        "name": "dakcoder-go",
        "label": "Go compiler, vet and test output",
        "owner": "dakcoder-gate",
        "source": "gate",
        "severity": "error",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$dakcoder-go"
      }
    ]
  }
}
