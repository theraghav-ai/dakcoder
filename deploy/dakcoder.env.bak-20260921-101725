# -- per-role models ---------------------------------------------------------
# Every role named explicitly, so the table in force is readable here rather
# than inferred from what each line does not say. All of them live on the
# LiteLLM above under the one key, so no role needs its own _BASE_URL or
# _API_KEY.
#
#   Qwen3.8-27B      the coding model — only where code is written or judged
#   Qwen3.6-35B      everything else
#   qwen3-embedding  the real embedding model (1024-dim)
#
# `GET /v1/models` (authenticated) publishes this table and the startup line
# prints it, so a change here is one you can see took effect.
DAKCODER_MODEL=Qwen3.6-35B         # the default, for any role added later

DAKCODER_MODEL_CODER=Qwen3.8-27B       # Agent mode — reading, writing, running the gates
DAKCODER_MODEL_DEBUGGER=Qwen3.8-27B    # fixing what the gates caught
DAKCODER_MODEL_VERIFIER=Qwen3.8-27B    # checking the work

DAKCODER_MODEL_PLANNER=Qwen3.8-27B      # Plan mode turns
DAKCODER_MODEL_ASK=Qwen3.6-35B          # Ask mode turns, which hold no write tool
DAKCODER_MODEL_FAST=Qwen3.6-35B         # the intent classifier: one call, 64 tokens
DAKCODER_MODEL_SUMMARISER=Qwen3.6-35B   # compaction recaps
# The training-server LiteLLM (vmaimltrg1) serves no embedding model, so this
# one role stays pinned to the local LiteLLM on its own key. Per-role overrides
# are additive — every other role still uses DAKCODER_MODEL_BASE_URL above.
DAKCODER_MODEL_EMBED=qwen3-embedding    # the embeddings endpoint
DAKCODER_MODEL_EMBED_BASE_URL=http://127.0.0.1:4000/v1
DAKCODER_MODEL_EMBED_API_KEY=sk-5c0ef4f1da1d23bd160c3c426c64487cae3889e4d6443f1e

