# Template. Copy to deploy/dakcoder.env, fill in the three blanks, chmod 600.
#
#   cp deploy/dakcoder.env.example deploy/dakcoder.env && chmod 600 deploy/dakcoder.env
#
# The real file is gitignored: it holds the shared LiteLLM credential, which
# only the gateway process may read (ARCHITECTURE §15.4).

# -- the model endpoint (LiteLLM, already running on this host) --------------
DAKCODER_MODEL_BASE_URL=http://127.0.0.1:4000/v1
DAKCODER_MODEL_API_KEY=            # the LiteLLM key — the only credential the gateway holds

# -- our own JWT signing secret ---------------------------------------------
DAKCODER_JWT_SECRET=              # >= 32 chars: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# -- state -------------------------------------------------------------------
DAKCODER_REDIS_URL=redis://127.0.0.1:6379/3
DAKCODER_POSTGRES_DSN=postgres://postgres:dakcoder@127.0.0.1:55432/dakcoder

# -- where the gateway listens ----------------------------------------------
DAKCODER_GATEWAY_HOST=127.0.0.1
DAKCODER_GATEWAY_PORT=8790
DAKCODER_VERSION=local

# -- identity ----------------------------------------------------------------
# No GitLab OAuth application is configured on this host, so the gateway runs
# its loopback-only dev identity provider and says so on /v1/health. Fill these
# three in and it switches to the real adapter with no other change.
#DAKCODER_GITLAB_URL=https://gitlab.cept.gov.in
#DAKCODER_GITLAB_CLIENT_ID=
#DAKCODER_GITLAB_CLIENT_SECRET=
DAKCODER_DEV_USER=localdev
DAKCODER_DEV_GROUPS=it-2.0/backend

# -- the runtime the extension would otherwise spawn -------------------------
DAKCODER_GATEWAY_URL=http://127.0.0.1:8790
DAKCODER_GATEWAY_TOKEN=          # random: authenticates the extension to its own runtime
DAKCODER_WORKSPACE=/mnt/data/raghav/dakcoder/new-template
DAKCODER_RUNTIME_PORT=8791
