# Template. Copy to deploy/dakcoder.env, fill in the three blanks, chmod 600.
#
#   cp deploy/dakcoder.env.example deploy/dakcoder.env && chmod 600 deploy/dakcoder.env
#
# The real file is gitignored: it holds the shared LiteLLM credential, which
# only the gateway process may read (ARCHITECTURE §15.4).

# -- the model endpoint (LiteLLM, already running on this host) --------------
# The default: what every role gets unless it names its own below.
DAKCODER_MODEL_BASE_URL=http://127.0.0.1:4000/v1
DAKCODER_MODEL_API_KEY=            # the LiteLLM key — the only credential the gateway holds
DAKCODER_MODEL=Qwen3.8-27B         # the model every role gets by default

# -- per-role models ---------------------------------------------------------
# Which model answers as the Planner, the Coder, the summariser and the rest is
# an operator's decision, taken here and applied by restarting the gateway. No
# code change, no redeploy, and nothing to keep in step: the runtime sends a
# role name and the gateway is the only side that knows what it resolves to.
#
# The roles, and where each is used:
#
#   planner     Plan mode turns
#   coder       Agent mode turns — reading, writing, running the gates
#   ask         Ask mode turns, which hold no write tool
#   fast        the intent classifier: one call, a two-key schema, 64 tokens
#   summariser  compaction recaps
#   embed       the embeddings endpoint
#   verifier    } retired as modes, kept as roles so a stored session or an
#   debugger    } older runtime naming one is routed rather than refused
#
# Three variables per role, each falling back to the defaults above, so the
# common change — a different model on the same endpoint — is one line:
#
#   DAKCODER_MODEL_<ROLE>            the model name
#   DAKCODER_MODEL_<ROLE>_BASE_URL   its endpoint, if it lives elsewhere
#   DAKCODER_MODEL_<ROLE>_API_KEY    its key, if that endpoint has its own
#
# A per-role key is still a key only the gateway holds: the launcher strips
# every DAKCODER_MODEL*_API_KEY from the runtime's environment, and the runtime
# refuses to start holding one.
#
# `GET /v1/models` (authenticated) publishes the table in force, and the startup
# line prints it — so a change here is one you can see took effect rather than
# one you infer from behaviour.
#
#DAKCODER_MODEL_PLANNER=Qwen3-235B-A22B
#DAKCODER_MODEL_PLANNER_BASE_URL=http://10.0.0.9:4000/v1
#DAKCODER_MODEL_PLANNER_API_KEY=
#DAKCODER_MODEL_FAST=Phi-4-mini-instruct
#DAKCODER_MODEL_SUMMARISER=Phi-4-mini-instruct

# Extra role names, beyond the ones listed above. Additive — the built-in roles
# are always configured, because the runtime calls `fast` and `summariser` on
# its own and a table missing them would fail the first compaction of the day.
#DAKCODER_MODEL_ROLES=reviewer

# -- our own JWT signing secret ---------------------------------------------
DAKCODER_JWT_SECRET=              # >= 32 chars: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# -- state -------------------------------------------------------------------
DAKCODER_REDIS_URL=redis://127.0.0.1:6379/3
DAKCODER_POSTGRES_DSN=postgres://postgres:dakcoder@127.0.0.1:55432/dakcoder

# -- quota -------------------------------------------------------------------
# Off while the agent is being tuned. The counters still run and /v1/quota still
# reports them — that is the point: the usage recorded here is what the real
# ceilings should be chosen from, rather than guessed at a second time.
#
# `false` opens every ceiling. Setting any DAKCODER_QUOTA_* value explicitly
# keeps that one in force, so a single guard can stay on: leaving
# DAKCODER_QUOTA_RUNS_PER_WINDOW=40 below still catches a runaway retry loop
# while token budgets stay open.
#
# To turn quota on after the pilot: set this to true, uncomment the ceilings you
# want, restart. No deploy, no code change. `/v1/health` publishes what is
# actually in force, and startup prints "quota: enforced" or "UNMETERED".
DAKCODER_QUOTA_ENFORCE=false

# Ceilings. Values are the defaults, all placeholders until measured. 0, "off"
# or "unlimited" means count but never refuse. Underscores and commas are fine.
#DAKCODER_QUOTA_TOKENS_PER_WINDOW=1_500_000
#DAKCODER_QUOTA_TOKENS_PER_HOUR=600_000
#DAKCODER_QUOTA_TOKENS_PER_WEEK=12_000_000
#DAKCODER_QUOTA_RUNS_PER_WINDOW=40
#DAKCODER_QUOTA_SESSIONS_PER_WEEK=12
#DAKCODER_QUOTA_WINDOW_HOURS=5
#DAKCODER_QUOTA_BACKGROUND_SHARE=0.25

# -- where the gateway listens ----------------------------------------------
DAKCODER_GATEWAY_HOST=127.0.0.1
DAKCODER_GATEWAY_PORT=8790
DAKCODER_VERSION=local

# -- identity ----------------------------------------------------------------
# No GitLab OAuth application is configured on this host, so the gateway runs
# its loopback-only dev identity provider and says so on /v1/health. Fill these
# three in and it switches to the real adapter with no other change.
#DAKCODER_GITLAB_URL=https://gitlab.cept.gov.in
#DAKCODER_GITLAB_CLIENT_ID=
#DAKCODER_GITLAB_CLIENT_SECRET=
DAKCODER_DEV_USER=localdev
DAKCODER_DEV_GROUPS=it-2.0/backend

# -- the runtime the extension would otherwise spawn -------------------------
DAKCODER_GATEWAY_URL=http://127.0.0.1:8790
DAKCODER_GATEWAY_TOKEN=          # random: authenticates the extension to its own runtime
DAKCODER_WORKSPACE=/mnt/data/raghav/dakcoder/new-template
DAKCODER_RUNTIME_PORT=8791
