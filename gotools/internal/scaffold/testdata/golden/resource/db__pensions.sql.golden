-- pensions — schema for the Pension resource.
--
-- Generated by gotools resource_scaffold. Review before applying:
--
--   psql -U <user> -d <database> -f db/pensions.sql
--
-- The agent deliberately does not run this. Applying DDL is the one action in
-- the workflow that `git restore` cannot undo.

CREATE TABLE IF NOT EXISTS public.pensions (
	id serial4 NOT NULL,
	ppo_number varchar(20) NOT NULL,
	amount numeric(12, 2) NOT NULL,
	status varchar(16) NOT NULL,
	sanction_date timestamp NOT NULL,
	created_at timestamp DEFAULT now() NOT NULL,
	updated_at timestamp DEFAULT now() NOT NULL,
	CONSTRAINT pensions_pkey PRIMARY KEY (id)
);

-- Indexes for the columns the list endpoint filters on. Without these, every
-- filtered request is a sequential scan.
CREATE INDEX IF NOT EXISTS idx_pensions_status ON public.pensions (status);
