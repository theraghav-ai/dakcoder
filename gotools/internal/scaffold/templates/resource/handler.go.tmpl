{{- if .R.Has "update"}}
func (h *{{.R.HandlerType}}) {{.R.HandlerUpdate}}(sctx *serverRoute.Context, req {{.R.UpdateReq}}) (*resp.{{.R.UpdateResp}}, error) {
{{- range .R.UpdateParams}}
	var {{.Name}} {{.Type}}
{{- if .AlwaysSet}}
	// A false bool is indistinguishable from an omitted one on a value-typed
	// request field, so this column is always written.
	{{.Name}} = &req.{{.Field.Go}}
{{- else}}
	if {{.ZeroTest "req."}} {
		{{.Name}} = &req.{{.Field.Go}}
	}
{{- end}}
{{- end}}

	{{.R.Var}}, err := h.svc.{{.R.RepoUpdate}}(sctx.Ctx, req.ID, {{args .R.UpdateParams}})
	if err != nil {
		log.Error(sctx.Ctx, "Error updating {{.R.Var}} by ID: %v", err)
		return nil, err
	}
	r := &resp.{{.R.UpdateResp}}{
		StatusCodeAndMessage: port.UpdateSuccess,
		Data:                 resp.{{.R.NewItemResp}}({{.R.Var}}),
	}
	return r, nil
}
{{end}}
